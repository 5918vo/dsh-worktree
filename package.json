{
  "name": "@5318vo/dsh-worktree",
  "version": "0.1.0",
  "description": "DeepSeek Worktree task plugin — publish git-worktree-backed tasks; each task is a real DSH session bound to its worktree.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs/frontend-design.md"
  ],
  "keywords": [
    "dsh",
    "deepseek",
    "harness",
    "git",
    "worktree",
    "task",
    "plugin"
  ],
  "author": "5318vo",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node build.mjs",
    "test": "node scripts/test.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true}); require('fs').rmSync('.test-dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run typecheck && npm run build",
    "pack:check": "npm pack --dry-run",
    "publish:dry": "npm publish --dry-run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
